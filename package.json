{
  "name": "@metyatech/qti-to-track",
  "version": "1.0.0",
  "description": "Convert QTI XML packages into Track LMS API payloads and publish them to Track.",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "qti-to-track": "dist/cli/index.js"
  },
  "scripts": {
    "start": "node ./dist/cli/index.js",
    "test": "vitest run",
    "build": "tsc",
    "verify": "npm run test && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "qti",
    "track",
    "track-lms",
    "assessment",
    "education"
  ],
  "author": "metyatech",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metyatech/qti-to-track.git"
  },
  "bugs": {
    "url": "https://github.com/metyatech/qti-to-track/issues"
  },
  "homepage": "https://github.com/metyatech/qti-to-track#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/cli",
    "dist/fs",
    "dist/generator",
    "dist/parser",
    "dist/publish",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/types.d.ts",
    "dist/types.js",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metyatech/track-tcm-api-client": "github:metyatech/track-tcm-api-client#28c15c58e28efe44b6f4d42b9c7195a3ab54cf29",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
