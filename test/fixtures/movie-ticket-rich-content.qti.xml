<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
    xmlns="http://www.imsglobal.org/xsd/imsqti_v3p0"
    identifier="movie-ticket-calculator"
    title="JavaScript応用Ⅰ 前期期末試験 対策問題：映画チケット料金計算アプリ"
    adaptive="false"
    time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="string"/>
  <qti-item-body>
    <h3>完成見本</h3>
    <p><a href="https://course-exam-demos.vercel.app/f21f43d1df7547c4/">完成見本を開く</a></p>
    <p>完成見本のソースコードを確認・利用することは禁止します。</p>
    <h3>完成させる機能</h3>
    <ol>
      <li><p>ページを開いたとき、3種類の映画名と基本価格を一覧表示する。</p></li>
      <li><p>選択した映画に応じて、結果欄に <code>action</code> クラスを付ける。</p></li>
    </ol>
    <h3>料金</h3>
    <table>
      <thead>
        <tr><th>項目</th><th style="text-align: right;">料金</th></tr>
      </thead>
      <tbody>
        <tr><td>アクション映画</td><td style="text-align: right;">1600円</td></tr>
        <tr><td>アニメ映画</td><td style="text-align: right;">1500円</td></tr>
      </tbody>
    </table>
    <h3>動作確認の例</h3>
    <table>
      <thead>
        <tr><th>選択内容</th><th>表示内容</th><th style="text-align: right;">合計金額</th><th>結果欄のクラス</th></tr>
      </thead>
      <tbody>
        <tr><td>アクション映画、一般席、追加商品なし</td><td>アクション映画（一般席）／追加商品なし</td><td style="text-align: right;">1600円</td><td><code>result-box action</code></td></tr>
      </tbody>
    </table>
    <qti-extended-text-interaction response-identifier="RESPONSE"/>
  </qti-item-body>
</qti-assessment-item>
